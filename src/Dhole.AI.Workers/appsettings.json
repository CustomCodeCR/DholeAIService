  "Security": {
    "LoginRateLimit": {
      "MaxFailedAttempts": 5,
      "WindowMinutes": 15,
      "BlockMinutes": 15
    }
  },
  "Messaging": {
    "Outbox": {
      "BatchSize": 50,
      "MaxRetryCount": 3,
      "PollingIntervalSeconds": 10,
      "BackgroundService": {
        "Enabled": true,
        "PollingIntervalSeconds": 10,
        "BatchSize": 50,
        "RunImmediately": true,
        "ErrorDelaySeconds": 5,
        "UseDistributedLock": false,
        "LockDurationSeconds": 60
      }
    },
    "Inbox": {
      "ProcessedMessageExpirationDays": 7,
      "Cleanup": {
        "Enabled": true,
        "OlderThanDays": 7,
        "BatchSize": 100,
        "PollingIntervalSeconds": 300,
        "RunImmediately": true
      }
    }
  },
  "Workers": {
    "Enabled": true,
    "MaxRetryCount": 3,
    "RetryDelaySeconds": 5,
    "UseDistributedLock": false,
    "LockDurationSeconds": 60,
    "StopOnUnhandledException": false,
