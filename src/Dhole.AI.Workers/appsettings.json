  "AI": {
    "EmailJobs": {
      "Enabled": true,
      "ProfileKey": "pricing-email-analysis",
      "MaxConcurrentJobs": 1,
      "MaxJobsPerRun": 1,
      "MaxRetryCount": 3,
      "LeaseMinutes": 30,
      "HeartbeatSeconds": 15,
      "RetryDelaysSeconds": [
        30,
        120,
        300
      ],
      "LeaseRecoveryGraceSeconds": 120,
      "HeartbeatDatabaseRetryCount": 5,
      "HeartbeatRetryDelaySeconds": 2,
      "MaximumJobAgeHours": 24
    },
    "Executions": {
      "RetentionDays": 90,
      "CleanupBatchSize": 500
